          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Inheritance relationships -->
        
        <!-- Score_board inherits from QWidget -->
        <mxCell id="Score_board-qwidget" value="" style="endArrow=block;endFill=0;html=1;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="Score_board" target="qwidget-methods">
