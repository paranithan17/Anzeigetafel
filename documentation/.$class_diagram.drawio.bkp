        <mxCell id="controll_window-qwidget" value="" style="endArrow=block;endFill=0;html=1;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="controll_window" target="qwidget-methods">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
