        <!-- timer inherits from QObject -->
        <mxCell id="timer-qobject" value="" style="endArrow=block;endFill=0;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="timer" target="qobject">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
