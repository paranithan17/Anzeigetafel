        </mxCell>

        <!-- score_memory inherits from QObject -->
        <mxCell id="score_memory-qobject" value="" style="endArrow=block;endFill=0;html=1;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="score_memory" target="qobject">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
