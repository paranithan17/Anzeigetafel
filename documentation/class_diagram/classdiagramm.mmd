classDiagram
  %% Qt Foundation Classes
  class QWidget {
    <<Qt>>
    +show()
    +hide()
  }

  class QTimer {
    <<Qt>>
    +void start()
    +void stop()
    +void timeout()
  }

  %% Enumerations & Data Structures
  class GoalEvent {
    +int playerNumber
    +QString playerName
    +QString teamId
    +QString timeStamp
    +bool ownGoal
  }

  class GoalData {
    +TeamSide scoringTeam
    +int playerNumber
    +QString playerName
    +unsigned goalMinute
    +bool isOwnGoal
  }

  %% Domain Model
  class Player {
    -unsigned playerNumber
    -QString playerName
    +Player(unsigned number, QString name)
    +unsigned getNumber()
    +QString getName()
    +void setName(QString name)
    +void setNumber(unsigned number)
  }

  class Team {
    -QString id
    -QString displayName
    -QString logoPath
    -vector~shared_ptr~Player~~ players
    +Team(QString id, QString displayName)
    +void addPlayer(unsigned number, QString name)
    +void removePlayer(unsigned number)
    +vector~shared_ptr~Player~~ getPlayers()
    +void setLogo(QString logoPath)
  }

  class ScoreMemory {
    -QList~GoalEvent~ goals
    +void addGoal(int number, QString player, QString teamId, QString timeStamp, bool ownGoal)
    +void removeGoal(int goalIndex)
    +int getHomeScore()
    +int getAwayScore()
    +QList~GoalEvent~ getGoals()
    +void clearGoals()
  }

  %% Timer Component
  class MatchTimer {
    -QElapsedTimer elapsed
    -QTimer tickTimer
    -bool running
    -MatchState phase
    +void start()
    +void stop()
    +void reset()
    +void setPhase(MatchState phase)
    +QString getCurrentTime()
    +MatchState getPhase()
  }

  %% CENTRAL CONTROLLER - All business logic
  class MatchController {
    <<MODEL>>
    -Team homeTeam
    -Team awayTeam
    -ScoreMemory* scoreMemory
    -MatchTimer* timer
    -MatchState state
    -QString homeTeamEmblem
    -QString awayTeamEmblem
    
    +addPlayer(TeamSide, unsigned, QString)
    +removePlayer(TeamSide, unsigned)
    +importPlayersFromCsv(TeamSide, QString)
    
    +addGoalWithValidation(GoalData)
    +removeLastGoal()
    
    +requestTimerStart()
    +requestTimerRestart()
    +requestTimerStop()
    +requestMatchReset()
    
    +requestStateChange(MatchState, bool)
    +startTimer() bool
    
    +setTeamEmblem(TeamSide, QString)
    +getTeamEmblem(TeamSide) QString
  }

  %% UI Component - Pure View (MVC Pattern)
  class ControlWindow {
    <<VIEW>>
    -match_controller* m_controller
    -QListWidget* listTeam1/2
    -QPushButton* buttons
    -QLabel* score/time
    -QRadioButton* stateRadios
    
    +onAddPlayerTeam1/2()
    +onRemovePlayerTeam1/2()
    +onAddGoalTeam1/2()
    +onStartTimer()
    +onLog()
    +onLoadEmblemTeam1/2()
    +onImportTeam1/2()
    +onApplyStateSelection()
    
    +updateTeamList1/2()
    +updateScoreDisplay()
    +updateTimeDisplay()
    +setScoreboard()
    +toggleScoreboard()
  }

  class ScoreBoard {
    <<VIEW>>
    -MatchState state
    -score_memory* Score
    -timer* gameTime
    -QLabel* scoreLabel
    -QLabel* timeLabel
    -QListWidget* scorerLists
    -QLabel* emblemLabels
    -QTimer* slideshowTimer
    -QString preGamePath
    -QString halfTimePath
    -QString postGamePath
  }

  class SlidesDataBase {
    PreGameSlides
    HalfTimeSlides
    PostGameSlides
  }

  %% Web/Network Components
  class WebSocketServer {
    <<WebComm>>
    +QString receiveMessage()
    +void sendMessage(QString message)
  }

  class WebPage {
    <<Frontend>>
    +sendJson(json)
    +receiveJson(json)
  }

  %% Qt Inheritance
  ControlWindow --|> QWidget
  ScoreBoard --|> QWidget
  MatchTimer --|> QTimer

  %% Domain Model Composition
  Team --* "0..*" Player 
  ScoreMemory *-- "0..*" GoalEvent 

  %% MVC PATTERN: Controller to Components
  MatchController --> ScoreMemory 
  MatchController --> MatchTimer 
  MatchController --> Team 
  
  %% View connections (both views use same controller)
  ControlWindow ..> MatchController : delegates all actions
  ScoreBoard ..> MatchController : displays state from
  
  %% ControlWindow only shows data from controller
  ControlWindow --> MatchController : reads
  ControlWindow --> MatchController : updates on

  %% UI to Data access (through controller)
  MatchController --> ScoreMemory 
  MatchController --> MatchTimer

  ScoreBoard --> ScoreMemory 
  ScoreBoard --> MatchTimer
  ScoreBoard --> SlidesDataBase 

  %% Web/WebInterface also delegates to same controller
  WebPage ..> MatchController : delegates all actions
  WebSocketServer --> WebPage : sends state

  note for MatchController "Business Logic Layer:\nAll game logic, state management,\ndata validation, and operations"
  note for ControlWindow "Presentation Layer:\nGUI for operator.\nAll interactions delegate to\nmatch_controller via signals/slots"
  note for WebPage "Alternative Presentation:\nWeb UI for operators.\nSame operations, same controller"